# Optional environment variables for the Celebrate app.
# The app runs fully on Netlify free-tier (Functions + Blobs) with zero required
# secrets. Every key below is optional and used only to harden or extend the site.

# --- Deploy / CI ----------------------------------------
# Public base URL used for canonical links, sitemap and Open Graph tags
# when they must match a custom domain (leave empty on netlify.app defaults).
# CELEBRATE_SITE_URL=https://example.com

# --- Rate limiting (function defaults: 5 writes/hour/IP) --
# CELEBRATE_MAX_WRITES_PER_HOUR=5

# --- Guestbook cap (default: 50 entries per wish) --------
# CELEBRATE_MAX_GUESTBOOK=50

# --- Wish payload limits (defaults) ----------------------
# CELEBRATE_MAX_WISH_BYTES=300000
# CELEBRATE_MAX_MEMORIES=25

# --- Analytics (optional, Privacy-first) ------------------
# CELEBRATE_ANALYTICS_ID=